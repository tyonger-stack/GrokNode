<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.groknode.feishu-bridge-watch</string>
  <key>ProgramArguments</key><array><string>/bin/sh</string><string>/Users/Apple/.groknode/feishu-inbox/run.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>2</integer>
  <key>StandardOutPath</key><string>/Users/Apple/.groknode/feishu-inbox/watch.out.log</string>
  <key>StandardErrorPath</key><string>/Users/Apple/.groknode/feishu-inbox/watch.err.log</string>
</dict>
</plist>
